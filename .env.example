# Catalog API — example env file.
# Copy to `.env` and edit values. Validated at boot by Joi
# (src/shared/config/env.validation.ts). See README §7 for the full table
# of variables (required, defaults, allowed values).

# ─── App ───
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ─── PostgreSQL ───
DB_HOST=postgres
DB_PORT=5432
DB_USER=catalog
DB_PASSWORD=catalog
DB_NAME=catalog

# ─── RabbitMQ ───
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=catalog.events
