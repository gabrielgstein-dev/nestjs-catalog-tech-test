{
  "name": "catalog-api",
  "version": "0.1.0",
  "description": "Catálogo de produtos — NestJS Clean/Hexagonal",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "docker:smoke:up": "docker compose -p catalog-smoke -f docker-compose.yml -f docker-compose.smoke.yml up --build",
    "docker:smoke:down": "docker compose -p catalog-smoke -f docker-compose.yml -f docker-compose.smoke.yml down -v",
    "lint": "eslint \"{src,test}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:watch": "jest --selectProjects unit --watch",
    "test:cov": "jest --selectProjects unit --coverage",
    "test:cov:all": "jest --runInBand --coverage",
    "test:e2e": "jest --selectProjects e2e --runInBand",
    "typeorm": "node -r ts-node/register ./node_modules/typeorm/cli.js -d src/shared/infra/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "@golevelup/nestjs-rabbitmq": "5.7.0",
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/cqrs": "10.2.7",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "10.2.3",
    "@nestjs/typeorm": "10.0.2",
    "amqp-connection-manager": "4.1.14",
    "amqplib": "0.10.4",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.7",
    "joi": "17.13.3",
    "nestjs-pino": "4.1.0",
    "pg": "8.13.1",
    "pino-http": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.30",
    "uuid": "11.0.3"
  },
  "overrides": {
    "multer": "2.1.1",
    "lodash": "4.18.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.22",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/jest-runner": "^8.7.1",
    "@testcontainers/postgresql": "^12.0.0",
    "@testcontainers/rabbitmq": "^12.0.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "@types/uuid": "10.0.0",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.2.1",
    "jest": "29.7.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2",
    "supertest": "7.0.0",
    "testcontainers": "^12.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3"
  },
  "jest": {
    "rootDir": ".",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "coverageDirectory": "<rootDir>/coverage",
    "testTimeout": 180000,
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "json-summary"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.spec.ts",
      "!src/**/__test-fixtures__/**",
      "!src/**/*.dto.ts",
      "!src/**/*.entity.ts",
      "!src/**/*.module.ts",
      "!src/**/migrations/**",
      "!src/modules/skeleton/**",
      "!src/main.ts",
      "!src/shared/infra/database/data-source.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 80,
        "functions": 85,
        "lines": 85
      },
      "src/modules/catalog/category/domain/": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "src/modules/catalog/product/domain/": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "src/shared/domain/": {
        "statements": 100,
        "branches": 100,
        "functions": 100,
        "lines": 100
      },
      "src/modules/catalog/category/application/": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      },
      "src/modules/catalog/product/application/": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      },
      "src/modules/audit/application/": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      },
      "src/shared/application/": {
        "statements": 95,
        "branches": 90,
        "functions": 95,
        "lines": 95
      },
      "src/modules/catalog/category/presentation/": {
        "statements": 90,
        "branches": 85,
        "functions": 90,
        "lines": 90
      },
      "src/modules/catalog/product/presentation/": {
        "statements": 90,
        "branches": 85,
        "functions": 90,
        "lines": 90
      },
      "src/modules/audit/presentation/": {
        "statements": 90,
        "branches": 85,
        "functions": 90,
        "lines": 90
      },
      "src/shared/infra/": {
        "statements": 80,
        "branches": 75,
        "functions": 80,
        "lines": 80
      }
    },
    "projects": [
      {
        "displayName": "unit",
        "rootDir": "<rootDir>",
        "testMatch": [
          "<rootDir>/src/**/*.spec.ts"
        ],
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "moduleNameMapper": {
          "^src/(.*)$": "<rootDir>/src/$1"
        },
        "testEnvironment": "node"
      },
      {
        "displayName": "e2e",
        "rootDir": "<rootDir>",
        "testMatch": [
          "<rootDir>/test/**/*.e2e-spec.ts"
        ],
        "transform": {
          "^.+\\.(t|j)s$": "ts-jest"
        },
        "moduleNameMapper": {
          "^src/(.*)$": "<rootDir>/src/$1"
        },
        "testEnvironment": "node"
      }
    ]
  }
}
